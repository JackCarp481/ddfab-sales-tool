# ── Server-side env for the /api admin functions ────────────────────────────
# Set these in Vercel (Project → Settings → Environment Variables) for prod, and
# copy this file to `.env` for local `vercel dev`. NEVER commit the real `.env`.
#
# The public onboarding form does NOT use these — its public Supabase URL + anon
# key are hardcoded in onboarding.html (public by design; RLS protects the data).

# Supabase project URL (same project the form writes to).
PUBLIC_SUPABASE_URL=https://rhrgedhbkfoibflsygbc.supabase.co

# Supabase service_role key — bypasses RLS so the admin can read all submissions.
# Server-only. Find it in Supabase → Project Settings → API.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Password for the /admin submissions viewer.
ADMIN_PASSWORD=choose-a-password

# Random 32+ char string used to HMAC-sign the admin session cookie.
AUTH_SECRET=change-me-to-a-long-random-string-min-32-chars
